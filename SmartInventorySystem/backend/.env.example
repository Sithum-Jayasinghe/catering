Jwt__Issuer=SriLankanCateringInventory
Jwt__Audience=InventoryUsers

# CORS - comma-separated list of allowed frontend origins
# Replace with your actual Vercel URL after deploying the frontend
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://your-app.vercel.app

# ASP.NET Core settings
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# AI Service URL (optional - only if you deploy the AI services)
AiService__BaseUrl=http://localhost:8001

# Redis (optional - leave empty to use in-memory cache)
REDIS_URL=
