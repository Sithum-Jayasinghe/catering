# Get this from: Supabase Dashboard > Project Settings > Database > Connection string
# Replace YOUR_SUPABASE_DB_PASSWORD with your actual database password
ConnectionStrings__Default=Host=db.adstcemhpbuzmomrbqko.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=Sithum_123;SSL Mode=Require;Trust Server Certificate=true

# JWT Settings
