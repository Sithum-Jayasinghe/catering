# Multi-stage Dockerfile for React + Vite Web App with Nginx
# Build stage
FROM node:20-alpine AS build
WORKDIR /app

# Install dependencies
COPY web-app/package*.json ./
RUN npm ci --only=production

# Copy source and build
COPY web-app/ ./
RUN npm run build

# Production stage with Nginx
FROM nginx:alpine
RUN addgroup -g 1001 -S nginx-app && \
    adduser -u 1001 -S nginx-app -G nginx-app

# Copy built assets
COPY --from=build --chown=nginx-app:nginx-app /app/dist /usr/share/nginx/html

# Copy Nginx configuration
COPY web-app/nginx.conf /etc/nginx/conf.d/default.conf

# Use non-root user
USER nginx-app

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
